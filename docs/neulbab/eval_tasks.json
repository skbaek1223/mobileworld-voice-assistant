      "expect": {"no_writes": true, "spoken_contains_any": [["조리", "만들"]]},
      "reference": [{"tool": "get_order_status"}, {"answer": "$say"}]
    },
    {
      "id": "P09-cancel",
      "role": "parent", "category": "cancel",
