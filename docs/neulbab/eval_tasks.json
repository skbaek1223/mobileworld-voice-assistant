      "user_replies": ["네"],
      "expect": {"new_orders": [], "no_writes": true,
                 "spoken_contains_any": [["버섯"], ["고르실 수 없", "주문할 수 없", "팔지", "없어요", "없습니다", "안 보여", "안 돼", "어려워"]]},
      "reference": [
        {"tool": "get_recommendations", "args": {"include_more": true}},
        {"answer": "버섯두부전골은 지금 고르실 수 없어요"}
      ]
    },
    {
      "id": "P07-stt-noise",
